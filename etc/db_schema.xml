<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="magecopilot_edgesync_failure" resource="default" engine="innodb" comment="MageCopilot EdgeSync Failure Records">
        <column xsi:type="int" name="failure_id" unsigned="true" nullable="false" identity="true" comment="Failure ID"/>
        <column xsi:type="varchar" name="topic" nullable="false" length="128" comment="Source Queue Topic"/>
        <column xsi:type="varchar" name="error_class" nullable="false" length="16" comment="Error Class (transient or poison)"/>
        <column xsi:type="varchar" name="error_code" nullable="false" length="64" comment="Machine-Readable Error Code"/>
        <column xsi:type="varchar" name="sku" nullable="true" length="64" comment="Affected Product SKU"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="true" comment="Affected Product Entity ID"/>
        <column xsi:type="text" name="detail" nullable="false" comment="Error Detail (No PII)"/>
        <column xsi:type="char" name="payload_hash" nullable="false" length="64" comment="SHA-256 Hash of Original Payload"/>
        <column xsi:type="mediumtext" name="payload" nullable="false" comment="Original Payload for Replay"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="open" comment="Failure Resolution Status"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="failure_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGECOPILOT_EDGESYNC_FAILURE_PAYLOAD_HASH_SKU">
            <column name="payload_hash"/>
            <column name="sku"/>
        </constraint>

        <index referenceId="MAGECOPILOT_EDGESYNC_FAILURE_STATUS_ERROR_CODE" indexType="btree">
            <column name="status"/>
            <column name="error_code"/>
        </index>
        <index referenceId="MAGECOPILOT_EDGESYNC_FAILURE_SKU" indexType="btree">
            <column name="sku"/>
        </index>
    </table>
</schema>
